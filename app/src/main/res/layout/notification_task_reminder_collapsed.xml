<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_notification_card_dark"
    android:padding="0dp">

    <!-- Left Priority Pill Bar -->
    <View
        android:id="@+id/notification_priority_bar"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginStart="0dp"
        android:background="@drawable/bg_priority_pill_high" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Row: Title + DateTime Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Task Title (bold, white, wraps) -->
            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@+id/notification_datetime_badge"
                android:text="Task Title"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginEnd="8dp" />

            <!-- DateTime Badge -->
            <LinearLayout
                android:id="@+id/notification_datetime_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:background="@drawable/bg_datetime_badge"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_calendar_small"
                    android:contentDescription="Calendar" />

                <TextView
                    android:id="@+id/notification_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Today, 16 Aug"
                    android:textColor="#B0B0C8"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="4dp"
                    android:text="|"
                    android:textColor="#555570"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/notification_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6:00 PM"
                    android:textColor="#B0B0C8"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Company name in accent color -->
        <TextView
            android:id="@+id/notification_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Company"
            android:textColor="#F87171"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Chevron -->
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_chevron_right"
        android:contentDescription="Open" />

</LinearLayout>
